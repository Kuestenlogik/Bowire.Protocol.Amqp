<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1515: the container fixtures are injected into public xUnit test classes and must be public.
         CA1054/CA1056: the URLs are [InlineData] theory arguments and fixture addresses handed to the
         plugin's string-typed serverUrl API, so they stay strings. -->
    <NoWarn>$(NoWarn);CA1515;CA1054;CA1056</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.RabbitMq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kuestenlogik.Bowire.Protocol.Amqp\Kuestenlogik.Bowire.Protocol.Amqp.csproj" />
  </ItemGroup>

</Project>
